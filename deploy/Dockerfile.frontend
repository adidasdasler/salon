# Builds all three SPAs; used by deploy.sh to sync dist/ into the nginx container.
FROM node:22-alpine AS build
ENV PNPM_HOME=/pnpm PATH=$PNPM_HOME:$PATH COREPACK_ENABLE_DOWNLOAD_PROMPT=0
RUN corepack enable && corepack prepare pnpm@9.12.0 --activate
WORKDIR /app
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json turbo.json ./
COPY apps/dashboard/package.json apps/dashboard/
COPY apps/marketing/package.json apps/marketing/
COPY apps/booking/package.json apps/booking/
COPY packages/core/package.json packages/core/
COPY packages/ui/package.json packages/ui/
COPY packages/config/package.json packages/config/
RUN pnpm install --frozen-lockfile \
    --filter @salon/dashboard... --filter @salon/marketing... --filter @salon/booking...
COPY packages packages
COPY apps apps
ARG VITE_API_URL=/v1
ENV VITE_API_URL=$VITE_API_URL
RUN pnpm --filter @salon/dashboard build \
 && pnpm --filter @salon/marketing build \
 && pnpm --filter @salon/booking build

# Extractable artifacts — copy out with: docker run/cp
FROM scratch AS export
COPY --from=build /app/apps/dashboard/dist  /dashboard
COPY --from=build /app/apps/marketing/dist  /marketing
COPY --from=build /app/apps/booking/dist    /booking
