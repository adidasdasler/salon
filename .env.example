# App
NODE_ENV=development
PORT=4000
API_PREFIX=v1
APP_URL=http://localhost:5173
PUBLIC_APP_HOST=localhost

# Database
DATABASE_URL=postgresql://salon:salon@localhost:5432/salon?schema=public
POSTGRES_USER=salon
POSTGRES_PASSWORD=change-me-32-chars-min
POSTGRES_DB=salon

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# JWT (RS256) — generate: openssl genrsa -out keys/private.pem 2048 && openssl rsa -in keys/private.pem -pubout -out keys/public.pem
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Cookies
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# CORS
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Integrations
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
TELEGRAM_BOT_TOKEN=
SMS_RU_API_KEY=
YANDEX_SMARTCAPTCHA_KEY=
YANDEX_SMARTCAPTCHA_SECRET=

# Monitoring
SENTRY_DSN=

# Logging
LOG_LEVEL=debug
